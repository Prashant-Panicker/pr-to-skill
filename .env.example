# Local environment template for pr-review-profiler.
#
# Copy this file to .env, set the required values, and export it before running:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# The application does not load .env automatically. Non-secret defaults can
# remain in config.yaml; environment values override matching YAML settings.

# --- Azure Foundry / Azure OpenAI ------------------------------------------

# Optional. Leave empty to use Azure AD authentication from `az login`.
AZURE_OPENAI_API_KEY=

# Required unless valid values are already present in config.yaml.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# Optional Azure model overrides.
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_API_MODE=responses
AGENT_REQUEST_TIMEOUT=1800
AGENT_MAX_OUTPUT_TOKENS=120000

# Optional AWS webhook-worker bounds. SAM sets these to 120 and 780 seconds.
# Keep the per-request timeout low enough to cover embedding plus two model
# calls within the overall workflow deadline.
PR_TO_SKILL_OPENAI_TIMEOUT=120
PR_TO_SKILL_WORKFLOW_DEADLINE=780

# --- GitHub ----------------------------------------------------------------

# The normal local path uses `gh auth login`; no variable is required.
# Alternatively, set a token with access to the configured repositories.
GITHUB_TOKEN=

# --- Amazon OpenSearch (optional local vector indexing/search) -------------

# Keep false to run mining and skill generation without vector storage.
AWS_OPENSEARCH_ENABLED=false
AWS_OPENSEARCH_ENDPOINT=https://your-collection.region.aoss.amazonaws.com
AWS_OPENSEARCH_INDEX=pr-review-notes
AWS_OPENSEARCH_SERVICE=aoss
AWS_OPENSEARCH_SIGN_REQUESTS=true
AWS_OPENSEARCH_VERIFY_CERTS=true
AWS_REGION=us-east-1

# OpenSearch requests use the standard AWS credential chain. Uncomment this
# only when using a named local profile.
# AWS_PROFILE=your-local-profile

# --- S3 artifact bootstrap (optional) --------------------------------------

# Required only with `python main.py ... --sync-aws-artifacts`.
ARTIFACT_BUCKET=
ARTIFACT_PREFIX=artifacts

# --- LocalStack development (optional) ------------------------------------

# Leave the endpoint empty for real AWS. `make local-bootstrap` writes the
# concrete local resource names and endpoint to the ignored .env.localstack.
PR_TO_SKILL_AWS_ENDPOINT_URL=
PR_TO_SKILL_LOCAL_STAGE=local

# OpenSearch is intentionally disabled by default because its local engine is
# resource intensive. Enabling this also requires adding opensearch to
# LOCALSTACK_SERVICES when starting LocalStack; see README.md.
PR_TO_SKILL_LOCAL_OPENSEARCH=false
LOCALSTACK_SERVICES=s3,sqs,dynamodb,secretsmanager

# Optional image override. The compose default uses the approved JFrog cache.
# LOCALSTACK_IMAGE=docker.io/localstack/localstack:4.1.0

# Optional inputs copied directly into LocalStack Secrets Manager by the
# bootstrap. Secret values are never written to .env.localstack.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=
