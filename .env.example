# Environment variable template for pr-review-profiler.
#
# Copy this file to .env and fill in your own values, or export these variables
# in your shell. .env is git-ignored so secrets are never committed. Values set
# here override the matching keys in config.yaml.
#
#   cp .env.example .env
#
# NOTE: nothing in the pipeline auto-loads a .env file. Either export these in
# your shell (e.g. `set -a; source .env; set +a`) or use a tool such as
# `direnv` / `dotenv`.

# --- Azure OpenAI authentication -------------------------------------------

# Optional. If set, key-based authentication is used for Azure OpenAI.
# If left unset/empty, the pipeline falls back to Azure AD (`az login`).
# Never commit a real key.
AZURE_OPENAI_API_KEY=

# --- Azure OpenAI connection (optional overrides for config.yaml) ----------

# Azure OpenAI resource endpoint (ENDPOINT_URL is also accepted).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Deployment name, not the base model name (DEPLOYMENT_NAME is also accepted).
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# API version string.
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# API surface: "responses" or "chat_completions".
AZURE_OPENAI_API_MODE=responses

# Request timeout in seconds (positive integer).
AGENT_REQUEST_TIMEOUT=1800
# Maximum output tokens per request (positive integer).
AGENT_MAX_OUTPUT_TOKENS=120000
